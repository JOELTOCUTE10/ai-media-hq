# ============================================================
# AI Media HQ - environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Core ---
ENVIRONMENT=development
# Local dev default is SQLite. Docker Compose overrides with Postgres.
DATABASE_URL=sqlite:///./ai_media_hq.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Background task runner ---
TASK_RUNNER_ENABLED=true
TASK_POLL_INTERVAL_SECONDS=2.0
MAX_AGENT_RETRIES=2

# --- AI provider (required for agents to actually run) ---
# One of: openai | anthropic | fake (tests only) | unconfigured
AI_PROVIDER=unconfigured
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Research integrations (optional until keys are provided) ---
TAVILY_API_KEY=
YOUTUBE_DATA_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- YouTube publishing (OAuth, Phase 6) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/publishing/youtube/callback

# --- Cost control ---
MONTHLY_BUDGET_USD=100.0
