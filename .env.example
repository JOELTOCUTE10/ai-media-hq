# ============================================================
# AI Media HQ - environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Core ---
ENVIRONMENT=development
# Local dev default is SQLite. Docker Compose overrides with Postgres.
DATABASE_URL=sqlite:///./ai_media_hq.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Background task runner ---
TASK_RUNNER_ENABLED=true
TASK_POLL_INTERVAL_SECONDS=2.0
MAX_AGENT_RETRIES=2

# --- AI provider (required for agents to actually run) ---
# One of: openai | anthropic | groq | mistral | openrouter | gemini |
#         openai_compatible | fake (tests only) | unconfigured
# groq / mistral / openrouter / gemini have permanent FREE tiers - see docs/INTEGRATIONS.md
AI_PROVIDER=unconfigured
# Empty AI_MODEL = sensible default per provider (e.g. gpt-4o-mini, openai/gpt-oss-20b)
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Free-tier providers - get keys at:
#   Groq:      https://console.groq.com/keys       (30 RPM, 1000 req/day)
#   Mistral:   https://console.mistral.ai/api-keys (~1 req/s)
#   OpenRouter: https://openrouter.ai/keys          (17 :free models, 20 RPM/50 RPD)
#   Gemini:    https://aistudio.google.com/app/apikey (1500 req/day)
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Custom OpenAI-compatible endpoint (self-hosted vLLM/Ollama etc.) with AI_PROVIDER=openai_compatible
OPENAI_BASE_URL=

# --- Research integrations (optional until keys are provided) ---
TAVILY_API_KEY=
YOUTUBE_DATA_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- YouTube publishing (OAuth, Phase 6) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/publishing/youtube/callback

# --- Cost control ---
MONTHLY_BUDGET_USD=100.0

# --- Production (video generation) ---
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=
